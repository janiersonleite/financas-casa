{
  "name": "minhas-carteiras",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "test:db": "node --test tests/db/*.test.js",
    "test:functions": "node --test tests/functions/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:static": "node --test tests/static/*.test.js",
    "test": "rm -rf tests/_out && node --test --test-concurrency=1 --test-timeout=120000 tests/db/*.test.js tests/functions/*.test.js tests/unit/*.test.js tests/static/*.test.js && node tests/summary.js",
    "test:resumo": "node tests/summary.js",
    "verify:sri": "node scripts/verify-sri.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "pg": "^8.23.1"
  },
  "private": true
}
