{
  "name": "Minhas Carteiras",
  "short_name": "Carteiras",
  "description": "Controle financeiro pessoal e familiar",
  "start_url": "/financas-casa/",
  "scope": "/financas-casa/",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#3b82f6",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Novo Lançamento",
      "short_name": "Novo",
      "description": "Abrir tela de novo lançamento",
      "url": "/financas-casa/?action=new-transaction",
      "icons": [{ "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Início",
      "short_name": "Início",
      "description": "Ir para a tela inicial",
      "url": "/financas-casa/",
      "icons": [{ "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text":  "text",
      "url":   "url",
      "files": [
        {
          "name":   "receipt",
          "accept": ["image/jpeg","image/png","image/gif","image/webp","application/pdf"]
        }
      ]
    }
  }
}
